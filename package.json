{
  "name": "wappy-kit",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Wappy: the open-source AI agent SDK for WhatsApp. Bring your own model, your own number, your own data. Local-first, no forced cloud, no vendor lock-in.",
  "homepage": "https://github.com/csr1010/whatsapp-ai-agent-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csr1010/whatsapp-ai-agent-sdk.git"
  },
  "bugs": "https://github.com/csr1010/whatsapp-ai-agent-sdk/issues",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "verify": "pnpm lint && turbo run typecheck build test",
    "gate": "node scripts/gate.mjs",
    "ctx": "node scripts/ctx.mjs",
    "contract:update": "node scripts/contract.mjs update",
    "ratchet": "node scripts/ratchet.mjs update"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
